# LM-Screen Environment Configuration

# System & Environment
APP_NAME=LM-Screen
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=lm-screen-super-secret-key-change-in-production-2026

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Database Configuration (SQLite default for rapid dev, PostgreSQL supported)
DATABASE_URL=sqlite:///./lm_screen.db
# DATABASE_URL=postgresql://user:password@localhost:5432/lmscreen

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Provider Architecture Defaults (Local default providers)
STORAGE_PROVIDER=local
OCR_PROVIDER=local
VERIFICATION_PROVIDER=local
LLM_PROVIDER=local

# Optional External API Keys (Leave blank for fallback local deterministic execution)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
