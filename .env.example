# LM-Screen Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# System & Environment
APP_NAME=LM-Screen
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_key_for_production

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Database Configuration (SQLite default for rapid dev, PostgreSQL supported)
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./lm_screen.db

# PostgreSQL (replace with your credentials):
# DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/lmscreen

# CORS Allowed Origins (comma-separated list — do NOT add * in production)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Provider Architecture Defaults (Local default providers — no external keys needed for demo)
STORAGE_PROVIDER=local
OCR_PROVIDER=local
VERIFICATION_PROVIDER=local
LLM_PROVIDER=local

# Optional External API Keys (Leave blank for fallback local deterministic execution)
# These are never required for the core demo flow.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
