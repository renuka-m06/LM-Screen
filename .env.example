# LM-Screen Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# ──────────────────────────────────────────────
# System & Environment
# ──────────────────────────────────────────────
APP_NAME=LM-Screen
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=

# ──────────────────────────────────────────────
# Backend Host & Port
# (Render provides PORT automatically — do not set PORT here)
# ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# ──────────────────────────────────────────────
# Database
# SQLite (local dev, no setup needed):
# DATABASE_URL=sqlite:///./lm_screen.db
#
# PostgreSQL (Render / production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ──────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────
# CORS — comma-separated allowed origins
# Example: https://lm-screen.vercel.app,http://localhost:5173
# DO NOT use * in production
# ──────────────────────────────────────────────
CORS_ORIGINS=

# ──────────────────────────────────────────────
# Optional External Keys (not required for core demo)
# ──────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
